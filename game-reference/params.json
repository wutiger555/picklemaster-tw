  "specials": [
    {
      "id": "inferno",
      "name": "烈焰爆裂抽擊",
      "title": "INFERNO DRIVE",
      "desc": "時速破百的火球直線轟出。接不準會被震退、只能撈出高球。",
      "counter": "抓準完美時機回擊就能破解，時機差會被震退。"
    },
    {
      "id": "thunder",
      "name": "天雷貫地",
      "title": "THUNDER STRIKE",
      "desc": "把球擊上高空，落雷般垂直砸下，落地後暴衝彈跳。",
      "counter": "地上會先出現落雷標記：提早跑到彈跳後的位置。"
    },
    {
      "id": "phantom",
      "name": "幻影分身",
      "title": "PHANTOM DINK",
      "desc": "球分裂成三顆幻影並大幅蛇行，只有一顆是真的。",
      "counter": "盯住不透明的那顆，幻影快落地時會消失。"
    },
    {
      "id": "frost",
      "name": "絕對零度",
      "title": "ABSOLUTE ZERO",
      "desc": "極強下旋，落地瞬間凍結在地面，幾乎彈不起來。",
      "counter": "落地前截擊就不會被凍住；落點會結冰，踩到會打滑。"
    },
    {
      "id": "cyclone",
      "name": "龍捲旋風",
      "title": "CYCLONE SLICE",
      "desc": "螺旋鑽進場內，落地瞬間被旋風捲著往側邊竄開。",
      "counter": "看旋風往哪邊吹，先站到那一側；截擊它就不會竄開。"
    },
    {
      "id": "quake",
      "name": "震地重砲",
      "title": "TECTONIC CANNON",
      "desc": "沉重的平抽砸進場內，落地掀起震波，附近的人站不穩、腳下打滑。",
      "counter": "在它落地前截擊，或離落點遠一點再接。"
    }
  ],
  "skills": [
    {
      "id": "squatSmash",
      "name": "夜行巴士・關燈",
      "title": "LIGHTS OUT",
      "desc": "秒蹲一記貼網重砲，順手把球場燈關掉 6 秒：對手看不到站位圈和落點提示，只剩你的球拖著車燈光軌。"
    },
    {
      "id": "spinSmash",
      "name": "幹他！城主嗆聲",
      "title": "TAUNT SMASH",
      "desc": "起跳轉體扣殺，落地對著對手大吼一聲：8 秒內對手手抖，失誤變多。"
    },
    {
      "id": "splash",
      "name": "爆噴一波・淹水",
      "title": "FLOOD ZONE",
      "desc": "一拍噴出大水，對手後半場淹水 6 秒：踩在水裡跑不快，球落在水上會像打水漂一樣彈很低。站到網前就沒有水。"
    },
    {
      "id": "dualCurve",
      "name": "左右逢源・分身",
      "title": "TWIN SHADOW",
      "desc": "打出左右飄的大曲球，同時召喚分身站在網前 2 分：搆得到的球會自動幫你截擊回去。吊高球可以越過分身。"
    },
    {
      "id": "cheer",
      "name": "全民應援",
      "title": "TEAM TAIWAN",
      "desc": "全場觀眾起立大喊「台灣隊加油！」：能量立刻 +50，10 秒內能量累積兩倍，必殺技馬上就能放。"
    },
    {
      "id": "pickle",
      "name": "醃漬大法・酸到軟腳",
      "title": "SOUR PICKLE",
      "desc": "一拍把對手醃進酸黃瓜罐：9 秒內對手手軟腳軟，出球變慢、跑不快。"
    },
    {
      "id": "feast",
      "name": "大胃王・吃光光",
      "title": "BIG EATER",
      "desc": "一口吞掉對手 25 點能量變成自己的；之後 8 秒對手賺到的能量也全進你的肚子。"
    },
    {
      "id": "roar",
      "name": "虎爺・虎嘯山林",
      "title": "TIGER ROAR",
      "desc": "擊球同時一聲虎嘯：對手嚇到愣住，下一拍手軟只能撈出高球，等你殺。"
    },
    {
      "id": "wave",
      "name": "大浪來了",
      "title": "BIG WAVE",
      "desc": "一拍掀起大浪橫掃對手半場：對手被捲向邊線、腳下打滑，中間空出一大片。"
    },
    {
      "id": "overclock",
      "name": "超頻模式",
      "title": "OVERCLOCK",
      "desc": "機體超頻 8 秒：跑速提升三成以上、手臂伸長，打得到平常救不到的球。"
    },
    {
      "id": "foxfire",
      "name": "狐火・幻影球",
      "title": "FOXFIRE",
      "desc": "球纏上狐火 8 秒：你打出去的球飛到一半就隱形，只剩一點藍色火光，到對手面前才現身。"
    }
  ],
